                "type": "text/javascript",
                "exec": [
                  "const today = new Date();",
                  "today.setUTCHours(0, 0, 0, 0);",
                  "pm.collectionVariables.set('expenseDate', today.toISOString());",
                  "try { pm.environment.set('expenseDate', today.toISOString()); } catch (error) {}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Solicitacao criada', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('reimbursementId', data.id);",
                  "try { pm.environment.set('reimbursementId', data.id); } catch (error) {}"
